# Database
# Local: docker run --name event-atlas-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# Prod: Neon connection string with ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_atlas?schema=public"

# Auth.js v5 (NEXTAUTH_ prefix used for backwards compat; AUTH_ prefix also works)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# NEXTAUTH_URL is required in production (set to your canonical origin, e.g. https://yourapp.com).
# In development, Auth.js v5 auto-detects the origin from the request — leave this unset unless
# you always run on a fixed port. Setting it to http://localhost:3000 while Turbopack picks a
# different port (e.g. 3006) will break every auth redirect.
# NEXTAUTH_URL="https://your-production-domain.com"

# Google OAuth (Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Provider APIs
TICKETMASTER_API_KEY=""
# Used by both the Meetup and Eventbrite adapters.
APIFY_API_TOKEN=""
# Optional. Override for the Eventbrite Apify actor (default: automation-lab/eventbrite-scraper).
APIFY_EVENTBRITE_ACTOR_ID=""

# Transactional email (resend.com)
RESEND_API_KEY=""

# ZIP -> lat/lng geocoding (opencagedata.com)
OPENCAGE_API_KEY=""

# Rate limiting (upstash.com Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Shared secret for Vercel Cron requests (validated by /api/sync/* and reminder cron)
# Generate: openssl rand -hex 32
CRON_SECRET=""
